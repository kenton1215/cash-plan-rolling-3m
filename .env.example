# ============ 大模型配置 (DeepSeek) ============
# 获取 API Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 模型名: 官方 deepseek-chat(快速对话模型, 即"Flash"级) / deepseek-reasoner(深度思考)
# 如使用第三方代理(硅基流动/火山方舟等)的 flash 版本, 改成对应模型名即可, 例如:
# DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3
DEEPSEEK_MODEL=deepseek-chat
# 接口地址(OpenAI兼容), 默认 DeepSeek 官方; 第三方代理填代理地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============ 数据库配置 ============
# 默认 SQLite(零部署, 适合单服务器/演示)
# 生产多用户高并发可切换 PostgreSQL / MySQL, 示例:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/cashplan
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/cashplan
# DATABASE_URL=sqlite:///./cash_plan.db
